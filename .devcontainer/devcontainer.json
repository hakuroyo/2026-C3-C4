{
  "name": "ROS 2 Workspace humble-ros",
  "remoteUser": "rosdev",
  "build": {
      "dockerfile": "Dockerfile",
      "args": {
          "USERNAME": "rosdev",
          "GID": "1000",
          "UID": "1000"
      }
  },
 
  "customizations" : {
    "jetbrains" : {
      "backend" : "IntelliJ"
    }
  },
  "workspaceFolder": "/home/rosdev/ros2_ws",
  "postCreateCommand": "bash -lc 'rosdep update && rosdep install -i --from-path src --rosdistro humble -y && colcon build'",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/rosdev/ros2_ws/src,type=bind",
  "mounts": [],
  "runArgs": [
      "--net=host"
  ]
}
